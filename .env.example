# Framescout secrets — referenced from config.yaml via !env tags.
# Primary config is config.yaml; this file holds only sensitive values.
#
# Copy to .env and fill in the values you actually need. The daemon
# reads ENV vars referenced by config.yaml at startup; unreferenced
# vars are ignored.

# --- Reolink Hub credentials (for source-reolink-hub) ---
REOLINK_PASSWORD=

# --- HTTP-multipart sink bearer token (optional) ---
INGEST_BEARER_TOKEN=

# --- MQTT broker credentials (optional, for sink-mqtt) ---
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Detector API keys (optional) ---
MEGADETECTOR_API_KEY=
DEEPFAUNE_API_KEY=

# --- Observability (optional) ---
LOG_LEVEL=info                    # trace | debug | info | warn | error
METRICS_PORT=9090                 # 0 = disabled
