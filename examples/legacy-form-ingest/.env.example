# Copy this to `.env`, fill in actual values, never commit it.

# Reolink Hub login (see config.yaml: sources[0].config.username)
REOLINK_PASSWORD=

# Legacy ingest endpoint bearer token
INGEST_BEARER_TOKEN=

# Home Assistant MQTT broker credentials
MQTT_USERNAME=
MQTT_PASSWORD=

# Detector service API keys (optional — set only if your services require auth)
MEGADETECTOR_API_KEY=
DEEPFAUNE_API_KEY=
