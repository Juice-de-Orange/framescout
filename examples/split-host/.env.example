# Daemon-host secrets — copy to .env next to docker-compose.daemon.yml
REOLINK_PASSWORD=changeme
INGEST_BEARER_TOKEN=changeme
MEGADETECTOR_API_KEY=changeme
CLASSIFY_API_KEY=changeme

# Inference host — same CLASSIFY_API_KEY/MEGADETECTOR_API_KEY,
# plus the pinned model SHA from `export_onnx.py`:
CLASSIFY_MODEL_SHA256=
