{
  "name": "@framescout/detector-classify-http",
  "version": "0.2.0",
  "description": "Framescout Detector plugin: POST cropped animal JPEGs to your own self-hosted classifier (FastAPI + ONNX). Returns species class + an embedding for per-individual recognition. Replaces DeepFaune; runs after MegaDetector.",
  "license": "Apache-2.0",
  "author": "Max Oberrauch",
  "homepage": "https://github.com/Juice-de-Orange/framescout/tree/main/packages/detector-classify-http#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juice-de-Orange/framescout.git",
    "directory": "packages/detector-classify-http"
  },
  "bugs": {
    "url": "https://github.com/Juice-de-Orange/framescout/issues"
  },
  "keywords": [
    "framescout-plugin",
    "framescout-detector",
    "classifier",
    "onnx",
    "individual-recognition",
    "wildlife"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "framescout": {
    "apiVersion": "^0.1.0",
    "kind": "detector",
    "id": "classify-http",
    "displayName": "Species + individual classifier (HTTP)"
  },
  "peerDependencies": {
    "@framescout/plugin-api": "workspace:^"
  },
  "dependencies": {
    "@framescout/detector-deepfaune-http": "workspace:^",
    "@framescout/individual-recognition": "workspace:^",
    "chokidar": "^4.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@framescout/plugin-api": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
