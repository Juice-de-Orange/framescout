    "kind": "detector",
    "id": "deepfaune-http",
    "displayName": "DeepFaune (HTTP)"
  },
  "peerDependencies": {
    "@framescout/plugin-api": "workspace:^"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
