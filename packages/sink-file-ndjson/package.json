{
  "name": "@framescout/sink-file-ndjson",
  "version": "0.0.0",
  "description": "Framescout Sink plugin: append observations to local NDJSON files (audit log + sink-overflow backend).",
  "license": "Apache-2.0",
  "author": "Max Oberrauch",
  "homepage": "https://github.com/Juice-de-Orange/framescout/tree/main/packages/sink-file-ndjson#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juice-de-Orange/framescout.git",
    "directory": "packages/sink-file-ndjson"
  },
  "bugs": { "url": "https://github.com/Juice-de-Orange/framescout/issues" },
  "keywords": ["framescout-plugin", "framescout-sink", "ndjson", "audit", "spool"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "framescout": {
    "apiVersion": "^0.1.0",
    "kind": "sink",
    "id": "file-ndjson",
    "displayName": "File NDJSON"
  },
  "peerDependencies": {
    "@framescout/plugin-api": "workspace:^"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@framescout/plugin-api": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
