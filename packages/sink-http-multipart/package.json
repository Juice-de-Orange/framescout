  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "framescout": {
    "apiVersion": "^0.1.0",
    "kind": "sink",
    "id": "http-multipart",
    "displayName": "HTTP Multipart"
  },
  "peerDependencies": {
    "@framescout/plugin-api": "workspace:^"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@framescout/plugin-api": "workspace:^",
    "@types/busboy": "^1.5.4",
