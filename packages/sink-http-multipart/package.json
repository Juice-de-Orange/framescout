{
  "name": "@framescout/sink-http-multipart",
  "version": "0.0.0",
  "description": "Framescout Sink plugin: generic multipart POST of best-frame JPEG + JSON observation metadata.",
  "license": "Apache-2.0",
  "author": "Max Oberrauch",
  "homepage": "https://github.com/Juice-de-Orange/framescout/tree/main/packages/sink-http-multipart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juice-de-Orange/framescout.git",
    "directory": "packages/sink-http-multipart"
  },
  "bugs": { "url": "https://github.com/Juice-de-Orange/framescout/issues" },
  "keywords": ["framescout-plugin", "framescout-sink", "http", "multipart"],
  "type": "module",
  "main": "./dist/index.js",
