{
  "name": "@framescout/source-reolink-hub",
  "version": "0.2.0",
  "description": "Framescout Source plugin: HTTP-poll a Reolink Hub Mini / Home Hub / RLN-series NVR for clip events.",
  "license": "Apache-2.0",
  "author": "Max Oberrauch",
  "homepage": "https://github.com/Juice-de-Orange/framescout/tree/main/packages/source-reolink-hub#readme",
  "repository": {
    "type": "git",
