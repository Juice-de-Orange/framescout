{
  "$comment": "release-as is set on every package and is STICKY in release-please: it forces this version on EVERY future release PR, not just the first. Remove all release-as entries right after the first public release, or every later release stays at the same version.",
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "separate-pull-requests": false,
